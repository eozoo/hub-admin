<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cowave.hub.admin.infra.rbac.mapper.SysScopeMapper">

    <resultMap id="scopeMap" type="com.cowave.hub.admin.domain.rbac.entity.SysScope">
        <result property="scopeId"      column="scope_id"/>
        <result property="scopeName"    column="scope_name"/>
        <result property="scopeContent" column="scope_content"
                typeHandler="com.cowave.zoo.framework.support.mybatis.handler.JsonObjectHandler"/>
    </resultMap>

    <select id="listScopeByPermit" resultMap="scopeMap">
        select s.scope_id, s.scope_name, s.scope_content
        from sys_menu m
        join sys_role_menu rm on m.menu_id = rm.menu_id and m.menu_permit = #{permit}
        join sys_role r on rm.role_id = r.role_id and r.role_code in
            <foreach collection="list"  item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        join sys_scope s on rm.scope_id = s.scope_id
    </select>
</mapper>
