<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cowave.hub.admin.infra.sys.mapper.SysFeedbackMapper">

    <resultMap id="statResult" type="com.cowave.hub.admin.domain.sys.entity.pto.FeedbackStatPto">
        <result column="total"     property="total"/>
        <result column="avg_score" property="avgScore"/>
    </resultMap>

    <!--
        评分统计：total / avgScore / scoreCount(1-5)
        scoreCount 在 Java 层通过 queryScoreCount 单独查询后拼装，
        此处只查 total 和 avgScore（兼容 PostgreSQL / MySQL）
    -->
    <select id="queryStat" resultMap="statResult">
        select
            count(*) as total,
            round(avg(score), 1) as avg_score
        from sys_feedback
        where tenant_id = #{tenantId}
    </select>

</mapper>
