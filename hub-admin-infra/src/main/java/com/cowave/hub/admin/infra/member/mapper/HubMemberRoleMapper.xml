<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cowave.hub.admin.infra.member.mapper.HubMemberRoleMapper">
    <select id="getRoleCodesByMemberId" resultType="java.lang.String">
        select r.role_code
        from sys_role r, hub_member_role ur
        where r.role_id = ur.role_id and ur.member_id = #{memberId}
    </select>
</mapper>
